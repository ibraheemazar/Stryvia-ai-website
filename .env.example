# ---------------------------------------------------------------------------
# Stryvia.ai — environment template. Copy to .env.local and fill in.
# Never commit real secrets. The Anthropic key is server-only.
# ---------------------------------------------------------------------------

# The Chat engine (server-side only — never exposed to the client)
ANTHROPIC_API_KEY=
# Model is pinned in code to claude-opus-4-8; override only for testing.
ANTHROPIC_MODEL=claude-opus-4-8

# Supabase — conversations, leads, admin auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is server-only; used by route handlers to write conversations.
SUPABASE_SERVICE_ROLE_KEY=

# Admin access — comma-separated allowlist of emails permitted into /admin
ADMIN_EMAIL_ALLOWLIST=

# Lead notification via Amazon SES. SES_* names are used (not AWS_*) so they
# don't collide with the runtime's reserved AWS_* variables.
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Marketing dashboard — optional Slack alerts for automations
SLACK_WEBHOOK_URL=

# Marketing channel connectors (each activates its module when present)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
SEARCH_CONSOLE_SITE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Performance connectors (Performance tab pulls live data when present)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Scheduled jobs (Vercel Cron) — set a secret so only Vercel can trigger them
CRON_SECRET=

# PostHog analytics (public — masked session replay configured in code)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Analytics 4 (public Measurement ID, G-XXXXXXX). Loaded only after the
# visitor grants analytics consent. Leave blank to disable GA entirely.
# NOTE: if NEXT_PUBLIC_GTM_ID is set, GA4 runs inside GTM instead and this
# direct tag stands down (no double counting) — configure GA4 as a tag in GTM.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container (public, GTM-XXXXXXX). When set, GTM becomes the
# single container (GA4 + ad pixels live in the GTM UI) with Consent Mode v2.
# Leave blank to keep GA4 firing directly via NEXT_PUBLIC_GA_MEASUREMENT_ID.
NEXT_PUBLIC_GTM_ID=

# Public site URL, used for metadata and hreflang
NEXT_PUBLIC_SITE_URL=https://stryvia.ai

# Data residency — the region actually selected at build time. Drives the
# honest Trust + Privacy copy. e.g. "eu-central-1 (Frankfurt)". If an
# in-Kingdom region is used, set IN_KINGDOM=true.
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_DATA_IN_KINGDOM=false

# ---------------------------------------------------------------------------
# STRYVIA IDEA LAB (/lab) — see docs/lab/SETUP_REQUIRED.md for the one-time
# human steps. Everything below is server-only unless marked NEXT_PUBLIC_.
# Replace the whole <...> placeholder (no brackets, no quotes).
# ---------------------------------------------------------------------------
# [OPTIONAL] Kill switch. Default true. Set false to show a "coming soon" page.
LAB_ENABLED=true
# [REQUIRED in production] Signs the visitor cookie. Any long random string:
#   openssl rand -base64 48
LAB_COOKIE_SECRET=<random-48-bytes>
# [OPTIONAL] Bot protection — Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add site).
# Production refuses to start without BOTH keys unless LAB_TURNSTILE_DISABLED=true is set explicitly.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
LAB_TURNSTILE_DISABLED=false
# [OPTIONAL] Founder notifications. Defaults to LEAD_NOTIFY_TO. WhatsApp uses the
# existing WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID and needs an E.164 number here.
LAB_NOTIFY_TO=
LAB_NOTIFY_WHATSAPP_TO=
# [OPTIONAL] Scheduling link placed in "Book a call" emails (Calendly / Cal.com).
LAB_SCHEDULING_URL=
# [OPTIONAL] Response-time promise in working days. UNSET = no promise is made
# anywhere (confirmation screen, brief copy email). Set only when the owner
# explicitly approves the commitment.
LAB_RESPONSE_DAYS=
# [OPTIONAL] Who may record or send a decision (comma-separated emails). Must be a
# subset of ADMIN_EMAIL_ALLOWLIST. UNSET = every allowlisted admin may decide.
LAB_REVIEWER_EMAILS=
# [OPTIONAL] Product defaults (config lives in src/config/lab.config.ts).
LAB_RETENTION_MONTHS=12
LAB_MAX_SESSIONS_PER_EMAIL_PER_DAY=3
LAB_MONTHLY_SPEND_ALERT_USD=200
LAB_MONTHLY_SPEND_HARD_CAP_USD=600
# [OPTIONAL] Model overrides per role (defaults: sonnet-5 interview/extract, opus-5-5 brief/assess).
LAB_MODEL_INTERVIEW=
LAB_MODEL_EXTRACT=
LAB_MODEL_BRIEF=
LAB_MODEL_ASSESS=
# [OPTIONAL] Voice transcription provider: browser | elevenlabs | openai | azure.
# "browser" needs no key (Web Speech API). See docs/lab/VOICE_PROVIDER_COMPARISON.md.
LAB_STT_PROVIDER=browser
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# [DEV/TEST ONLY — refused in production] mock AI provider and mail sink.
# LAB_AI_PROVIDER=mock
# LAB_MAIL_PROVIDER=log
